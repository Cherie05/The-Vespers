# VesperAero Environment Configuration Template
# Copy this file to server/.env or configure in your deployment platform (e.g., Railway)

# Server Port
PORT=5000
NODE_ENV=development

# Google Gemini API Key (Multimodal Vision Forensic Analysis)
GEMINI_API_KEY=your_gemini_api_key_here

# NASA FIRMS Satellite Active Fire Hotspot API Key (Optional)
FIRMS_MAP_KEY=your_nasa_firms_map_key_here

# Judge VIP Passcode Header (Bypasses rate limiting during hackathon evaluations)
JUDGE_SECRET_TOKEN=vesper-eval-2026

# Daily API Quota Circuit Breaker (Auto-fallbacks to Calibrated Engine on limit)
DAILY_GEMINI_CAP=1000

# Open-Source Object Storage (MinIO / S3) - Optional for Docker stack
S3_ENDPOINT=http://minio:9000
S3_BUCKET_NAME=vesperaero-evidence
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin_secure_2026

# Open-Source Redis Cache - Optional for Docker stack
REDIS_HOST=redis
REDIS_PORT=6379
